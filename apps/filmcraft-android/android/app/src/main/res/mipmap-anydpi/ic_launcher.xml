<?xml version="1.0" encoding="utf-8"?>
<!-- VantaCut's own icon (drawable/ic_launcher_tile): the glyph inset to the 72 dp a launcher
     shows, on the brand's deep black. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_tile"
            android:inset="18dp" />
    </foreground>
</adaptive-icon>
